# Fork openent publié sur GitHub Packages (scope @open-ent). En CI: NODE_AUTH_TOKEN
# = GITHUB_TOKEN. En local: un PAT GitHub (scope read:packages) dans l'env.
# Nécessaire à la racine du workspace : pnpm -r install lit la .npmrc racine.
@open-ent:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
auto-install-peers=true
